{
    "sea_level": 25,
    "disable_mob_generation": true,
    "ore_veins_enabled": false,
    "aquifers_enabled": false,
    "legacy_random_source": false,
    "default_block": {
        "Name": "create:asurine"
    },
    "default_fluid": {
        "Name": "minecraft:water"
    },
    "spawn_target": [],
    "noise": {
        "min_y": 0,
        "height": 256,
        "size_horizontal": 4,
        "size_vertical": 1
    },
    "noise_router": {
        "initial_density_without_jaggedness": 0.0,
        "barrier": 0.0,
        "fluid_level_floodedness": 0.0,
        "fluid_level_spread": 0.0,
        "lava": 0.0,
        "vein_toggle": 0.0,
        "vein_ridged": 0.0,
        "vein_gap": 0.0,
        "temperature": 0.0,
        "vegetation": 0.0,
        "continents": 0.0,
        "erosion": 0.0,
        "depth": 0.0,
        "ridges": 0.0,
        "final_density": {
            "type": "add",
            "argument1": {
                "type": "y_clamped_gradient",
                "from_y": 20,
                "to_y": 30,
                "from_value": 2.1,
                "to_value": -2.1
            },
            "argument2": {
                "type": "noise",
                "noise": "hexahedron:large_islands",
                "xz_scale": 1,
                "y_scale": 0
            }
        }
    },
    "surface_rule": {
       "type": "minecraft:sequence",
       "sequence": [
        {
            "type": "condition",
            "if_true": {
                "type": "vertical_gradient",
                "random_name": "minecraft:bedrock_floor",
                "true_at_and_below": {
                    "above_bottom": 0
                },
                "false_at_and_above": {
                    "above_bottom": 5
                }
            },
            "then_run": {
                "type": "block",
                "result_state": {
                    "Name": "minecraft:bedrock"
                }
            }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:y_above",
            "anchor": { "absolute": 25 },
            "surface_depth_multiplier": 0,
            "add_stone_depth": false
          },
          "then_run":  {
               "type": "condition",
               "if_true": {
                   "type": "stone_depth",
                   "surface_type": "floor",
                   "offset": 0,
                   "add_surface_depth": false,
                   "secondary_depth_range": 0
               },
               "then_run": {
                   "type": "block",
                   "result_state": {
                       "Name": "grass_block"
                   }
               }
           }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 1,
            "surface_type": "floor",
            "add_surface_depth": true,
            "secondary_depth_range": 1
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "biomesoplenty:orange_sand"
            }
          }
        }
       ]
     }
}