  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
          "type": "condition",
          "if_true": {
              "type": "vertical_gradient",
              "random_name": "minecraft:bedrock_floor",
              "true_at_and_below": {
                  "above_bottom": 0
              },
              "false_at_and_above": {
                  "above_bottom": 5
              }
          },
          "then_run": {
              "type": "block",
              "result_state": {
                  "Name": "minecraft:bedrock"
              }
          }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:y_above",
          "anchor": {
            "absolute": 80
          },
          "surface_depth_multiplier": 2,
          "add_stone_depth": true
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 1,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:magma_block"
            }
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "noise": "hexahedron:small_islands",
          "min_threshold": -2,
          "max_threshold": 0.5
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 2,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": {
