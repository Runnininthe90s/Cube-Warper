        "min_y": 0,
        "height": 256,
        "size_horizontal": 4,
        "size_vertical": 1
    },
    "noise_router": {
        "initial_density_without_jaggedness": 0.0,
        "barrier": 0.0,
        "fluid_level_floodedness": 0.0,
        "fluid_level_spread": 0.0,
        "lava": 0.0,
        "vein_toggle": 0.0,
        "vein_ridged": 0.0,
        "vein_gap": 0.0,
        "temperature": 0.0,
        "vegetation": 0.0,
        "continents": 0.0,
        "erosion": 0.0,
        "depth": 0.0,
        "ridges": 0.0,
        "final_density": {
            "type": "add",
            "argument1": {
                "type": "y_clamped_gradient",
                "from_y": 50,
                "to_y": 100,
                "from_value": 1.1,
                "to_value": -1.1
            },
            "argument2": {
                "type": "noise",
                "noise": "hexahedron:smooth_fields",
                "xz_scale": 1,
                "y_scale": 0
            }
        }
    },
    "surface_rule": {
        "type": "sequence",
        "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:noise_threshold",
                "noise": "hexahedron:large_islands",
                "min_threshold": 0.1,
                "max_threshold": 0.2
              },
              "then_run": {
                "type": "minecraft:block",
