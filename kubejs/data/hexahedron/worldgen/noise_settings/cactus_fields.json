                }
              }
            },
            {
                "type": "condition",
                "if_true": {
                    "type": "stone_depth",
                    "surface_type": "floor",
                    "offset": 0,
                    "add_surface_depth": false,
                    "secondary_depth_range": 1
                },
                "then_run": {
                    "type": "block",
                    "result_state": {
                      "Name": "minecraft:sand"
                    }
                }
            }
        ]
    }
}